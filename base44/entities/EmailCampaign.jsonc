{
  "name": "EmailCampaign",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Related Lead ID"
    },
    "campaign_name": {
      "type": "string",
      "description": "Name of the drip campaign"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Paused",
        "Completed"
      ],
      "default": "Active",
      "description": "Current status of the campaign"
    },
    "current_sequence": {
      "type": "number",
      "default": 0,
      "description": "Current email sequence number"
    },
    "started_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the campaign started"
    },
    "next_send_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the next email will be sent"
    }
  },
  "required": [
    "lead_id",
    "campaign_name"
  ]
}